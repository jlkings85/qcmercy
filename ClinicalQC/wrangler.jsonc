{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clinicalqc",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mercyqc",
      "database_id": "ce971014-a56f-4456-868d-b21cd1a3478c",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "BETTER_AUTH_URL": "https://qc.clinicalapps.app"
  },
  "routes": [
    {
      "pattern": "qc.clinicalapps.app",
      "custom_domain": true
    }
  ]
}
